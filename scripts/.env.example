# PaddleOCR (local)
PADDLE_OCR_PYTHON=.venv/bin/python
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

# Cursor Agent SDK (local pipeline)
# Copy this file to scripts/.env (gitignored) and fill in the key.
# Existing process env vars win over this file.
CURSOR_API_KEY=
# CURSOR_SUMMARY_MODEL=grok-4.6
# CURSOR_VISION_MODEL=composer-2.5
# CURSOR_AGENT_TIMEOUT_MS=900000
# CURSOR_SUMMARY_TIMEOUT_MS=1200000
# CURSOR_AGENT_MAX_RETRIES=2
# CURSOR_AGENT_RETRY_DELAY_MS=5000

# iCloud backup (local-inbox-server at 03:00, or: node scripts/backup-daily.mjs)
# Full snapshot of daily-inbox/ + summaries/; keep 2 newest zips
# Default: ~/Library/Mobile Documents/com~apple~CloudDocs/ZSXQ-AI-Explainer
# ICLOUD_BACKUP_DIR=
# ICLOUD_BACKUP=0
# BACKUP_KEEP_DAYS=2
