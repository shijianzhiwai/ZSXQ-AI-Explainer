# PaddleOCR (local)
PADDLE_OCR_PYTHON=.venv/bin/python
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

# Cursor CLI agent (local pipeline)
# Requires `agent` on PATH and logged-in Cursor session
# CURSOR_AGENT_BIN=agent
# CURSOR_SUMMARY_MODEL=gpt-5.5-medium
# CURSOR_VISION_MODEL=auto
# CURSOR_AGENT_TIMEOUT_MS=900000
# CURSOR_SUMMARY_TIMEOUT_MS=1200000
